# INTVL 2.0 Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Strava OAuth 2.0 Credentials (https://www.strava.com/settings/api)
STRAVA_CLIENT_ID="your_strava_client_id"
STRAVA_CLIENT_SECRET="your_strava_client_secret"

# Strava Webhook Verification Token (used during GET /api/webhooks/strava handshake)
STRAVA_VERIFY_TOKEN="INTVL2_WEBHOOK_SECRET_2025"

# Session Signing Secret (used for HMAC-SHA256 HTTP-only session cookies)
SESSION_SECRET="replace_with_32_byte_hex_secret_for_cookie_signing"

# Optional Local SQLite Database Path (used automatically during standard `npm run dev`)
LOCAL_SQLITE_PATH="./.local-intvl2.sqlite"
